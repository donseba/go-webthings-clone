{{/* @dot github.com/donseba/go-webthings/modules/polls.ListView */}}
{{- /* Every published poll, each with the polls module's box component. */ -}}
<main id="content" class="column">
    <header class="page-header">
        <h1>{{.Title}}</h1>
    </header>

    {{range .Polls}}
        <div class="section">{{pollBox $.Key .ID}}</div>
    {{else}}
        <p class="empty">{{tl localizer "No polls yet."}}</p>
    {{end}}
</main>
