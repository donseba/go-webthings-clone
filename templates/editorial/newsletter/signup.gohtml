{{/* @dot github.com/donseba/go-webthings/modules/newsletter.SignupView */}}
{{- /*
    The newsletter's own page, where the links in its e-mails land. The
    form returns the visitor to the element whose id is the instance key.
*/ -}}
<main id="content" class="column">
    <header class="page-header">
        <h1>{{.Title}}</h1>
    </header>

    {{with .Intro}}<div class="prose">{{.}}</div>{{end}}

    <section class="signup" id="{{.Key}}" aria-label="{{tl localizer "Subscribe"}}">
        {{if eq .Result "check-mail"}}
            <p class="wt-notice" role="status">{{tl localizer "Almost done: check your inbox and confirm your subscription."}}</p>
        {{else if eq .Result "confirmed"}}
            <p class="wt-notice" role="status">{{tl localizer "Your subscription is confirmed."}}</p>
        {{else if eq .Result "unsubscribed"}}
            <p class="wt-notice" role="status">{{tl localizer "You are unsubscribed."}}</p>
        {{else if eq .Result "invalid"}}
            <p class="wt-notice" role="status">{{tl localizer "That did not work. Please check your e-mail address or link."}}</p>
        {{else if eq .Result "throttled"}}
            <p class="wt-notice" role="status">{{tl localizer "Too many attempts. Please try again later."}}</p>
        {{end}}

        {{form_open .Form}}
            {{/* The fields and their limits come from the module (newsletter.SubscribeInput). */}}
            {{form_field .Form "locale" nil}}
            {{form_field .Form "email" nil}}
            {{form_field .Form "name" nil}}

            <p><button class="wt-button" type="submit">{{tl localizer "Subscribe"}}</button></p>
            <p class="wt-form__help">{{tl localizer "You receive an e-mail to confirm your address. Every newsletter has a link to unsubscribe."}}</p>
        {{form_close}}
    </section>
</main>
