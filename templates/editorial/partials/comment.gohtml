{{/* @dot github.com/donseba/go-webthings/modules/comments.Comment */}}
{{- /* A comment or guestbook message with its replies; staff replies are marked. */ -}}
<article class="comment" id="comment-{{.ID}}">
    <header class="comment__header">
        <strong>{{.Name}}</strong>
        <time class="comment__date" datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}">{{date .CreatedAt}}</time>
    </header>
    <div class="comment__body">{{.HTML}}</div>

    {{range .Replies}}
        <article class="comment comment--reply{{if .Staff}} comment--staff{{end}}" id="comment-{{.ID}}">
            <header class="comment__header">
                <strong>{{.Name}}</strong>
                {{if .Staff}}<span class="badge">{{tl localizer "Team"}}</span>{{end}}
                <time class="comment__date" datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}">{{date .CreatedAt}}</time>
            </header>
            <div class="comment__body">{{.HTML}}</div>
        </article>
    {{end}}
</article>
