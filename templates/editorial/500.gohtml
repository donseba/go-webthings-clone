{{/* @dot github.com/donseba/go-partial/ext/errors.Data */}}
{{/* @model View github.com/donseba/go-webthings/frontend.View */}}
{{- /*
    Shown on its own, without the layout, with status 500, when a template
    or a visitor action fails; never the error itself, which is in the log.
    .Title and .Message are go-partial's safe heading and sentence, already
    in the page's language.
*/ -}}
<!doctype html>
<html lang="{{View.Locale}}" data-accent="{{View.Theme.Values.accent}}" data-text="{{View.Theme.Values.text}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{{tl localizer "Something went wrong"}} · {{View.Site.Name}}</title>
    <meta name="robots" content="noindex">
    {{styles "webthings.css" "site.css"}}
</head>
<body>
    <header class="masthead">
        <a class="masthead__title" href="{{View.Site.HomeURL}}"><span>{{View.Site.Name}}</span></a>
    </header>

    <main id="content" class="column">
        <header class="page-header">
            <p class="kicker">500</p>
            <h1>{{tl localizer "Something went wrong"}}</h1>
            <p class="standfirst">{{.Message}}</p>
        </header>

        <p><a href="{{View.Site.HomeURL}}">{{tl localizer "Back to the home page"}}</a></p>
    </main>
</body>
</html>
