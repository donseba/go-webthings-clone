{{/* @dot github.com/donseba/go-webthings/modules/registrations.RegistrationView */}}
{{- /* One registration, with its cancel form. */ -}}
<main id="content" class="column">
    <header class="page-header">
        <p class="kicker">{{tl localizer "Registration"}}</p>
        <h1>{{.Subject.Title}}</h1>
        {{/* When the event takes place; zero for other subjects. */}}
        {{if not .Subject.When.IsZero}}
            <p class="standfirst">{{template "partials/when.gohtml" .Subject.When}}</p>
        {{end}}
    </header>

    {{if eq .Result "registered"}}<p class="wt-notice" role="status">{{tl localizer "Thank you, you are registered. We sent you a confirmation."}}</p>{{end}}

    <dl class="facts">
        <dt>{{tl localizer "Registration code"}}</dt><dd>{{.Code}}</dd>
        <dt>{{tl localizer "Name"}}</dt><dd>{{.Name}}</dd>
        <dt>{{tl localizer "Adults"}}</dt><dd>{{.Adults}}</dd>
        {{if .Children}}<dt>{{tl localizer "Children"}}</dt><dd>{{.Children}}</dd>{{end}}
        {{if .Total}}<dt>{{tl localizer "Total"}}</dt><dd>{{money .Total .Currency}}</dd>{{end}}
        {{with .Notes}}<dt>{{tl localizer "Remarks"}}</dt><dd>{{.}}</dd>{{end}}
        <dt>{{tl localizer "Registered on"}}</dt><dd>{{date .CreatedAt}}</dd>
    </dl>

    {{if eq .Payment "pending"}}{{with .PaymentLink}}<p>{{tl localizer "Please pay using:"}} {{.}}</p>{{end}}{{end}}
    {{with .Info}}<div class="prose">{{.}}</div>{{end}}

    {{/* The cancel form returns the visitor here, to the element with the id .Key. */}}
    <section class="signup" id="{{.Key}}" aria-label="{{tl localizer "Cancel registration"}}">
        {{if eq .Result "cancelled"}}<p class="wt-notice" role="status">{{tl localizer "Your registration is cancelled."}}</p>{{end}}
        {{if eq .Result "invalid"}}<p class="wt-notice" role="status">{{tl localizer "That e-mail address does not match this registration."}}</p>{{end}}
        {{if eq .Result "throttled"}}<p class="wt-notice" role="status">{{tl localizer "Too many attempts. Please try again later."}}</p>{{end}}

        {{if .Cancelled}}
            <p class="empty">{{tl localizer "This registration is cancelled."}}</p>
        {{else}}
            {{form_open .Form}}
                {{form_field .Form "code" nil}}
                {{form_field .Form "email" nil}}

                <p><button class="wt-button" type="submit">{{tl localizer "Cancel registration"}}</button></p>
            {{form_close}}
        {{end}}
    </section>
</main>
