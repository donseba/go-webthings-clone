{{/* @dot github.com/donseba/go-webthings/modules/publishing.Post */}}
{{- /*
    One post of any publishing instance, with the share links and the
    comments (fragments/comments.gohtml) below it.
*/ -}}
<main id="content" class="column">
    <article class="post">
        <header class="page-header">
            {{if not .Date.IsZero}}<p class="kicker"><time datetime="{{.Date.Format "2006-01-02"}}">{{date .Date "long"}}</time></p>{{end}}
            <h1>{{.Title}}</h1>
            {{with .Excerpt}}<p class="standfirst">{{.}}</p>{{end}}
        </header>

        {{template "partials/lead-image.gohtml" .}}

        <div class="prose">{{.Body}}</div>

        <footer class="post__footer">
            {{with .Categories}}
                <p class="tags"><span class="visually-hidden">{{tl localizer "Categories"}}:</span>{{range .}}<a href="{{.URL}}">{{.Title}}</a>{{end}}</p>
            {{end}}

            {{shareBar "" .Title}}
        </footer>
    </article>

    {{requiredSlot "comments"}}
</main>
