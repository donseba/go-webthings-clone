{{/* @dot github.com/donseba/go-webthings/modules/polls.ListView */}}
{{/* Starting point generated by WebThings: every published poll, each with the box component. */}}
<main id="content">
    <h1>{{.Title}}</h1>

    {{range .Polls}}
        {{pollBox $.Key .ID}}
    {{else}}
        <p>No polls yet.</p>
    {{end}}
</main>
