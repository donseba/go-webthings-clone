{{/* @dot github.com/donseba/go-webthings/modules/comments.ListView */}}
{{/* Starting point generated by WebThings: a guestbook with its form. */}}
<main id="content">
    <h1>{{.Title}}</h1>

    {{/* The form returns the visitor here, to the element with the id {{.Key}}. */}}
    <section id="{{.Key}}">
        {{if eq .Result "sent"}}<p>Thank you for your message.</p>{{end}}
        {{if eq .Result "pending"}}<p>Thank you. Your message is shown after approval.</p>{{end}}
        {{if eq .Result "invalid"}}<p>Please fill in your name and a message.</p>{{end}}
        {{if eq .Result "throttled"}}<p>You posted several messages already. Please try again later.</p>{{end}}
        {{if and (eq .Result "closed") (not .Closed)}}<p>New messages were closed when you posted. Please try again.</p>{{end}}

        {{if .Closed}}
            <p>New messages are closed.</p>
        {{else}}
            {{form_open .Form}}
                {{/* The fields and their limits come from the module (comments.PostInput), with the classes of webthings.css. */}}
                {{form_field .Form "subject" nil}}
                {{form_field .Form "name" nil}}
                {{form_field .Form "email" nil}}
                {{form_field .Form "body" nil}}

                <button type="submit">Send</button>
            {{form_close}}
        {{end}}
    </section>

    {{range .Comments}}
        <article id="comment-{{.ID}}">
            <p><strong>{{.Name}}</strong> · {{date .CreatedAt}}</p>
            {{.HTML}}

            {{range .Replies}}
                <blockquote>
                    <p><strong>{{if .Staff}}Reply from the site{{else}}{{.Name}}{{end}}</strong> · {{date .CreatedAt}}</p>
                    {{.HTML}}
                </blockquote>
            {{end}}
        </article>
    {{else}}
        <p>No messages yet.</p>
    {{end}}

    <nav>
        {{with .NewerURL}}<a href="{{.}}">Newer</a>{{end}}
        {{with .OlderURL}}<a href="{{.}}">Older</a>{{end}}
    </nav>
</main>
