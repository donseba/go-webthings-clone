{{/* @dot github.com/donseba/go-webthings/frontend.Page */}}
{{/* Starting point generated by WebThings: every field of the data is used below. */}}
<main id="content">
    {{/* ID: {{.ID}} — stable, usable as an anchor */}}
    {{with .ParentID}}<p>{{.}}</p>{{end}}
    {{with .Slug}}<p>{{.}}</p>{{end}}
    {{with .Path}}<p>{{.}}</p>{{end}}
    <h1>{{.Title}}</h1>
    {{with .Description}}<p>{{.}}</p>{{end}}
    <div>{{.Body}}</div>
    {{with .URL}}<a href="{{.}}">URL</a>{{end}}
    {{if .IsHome}}<p>IsHome</p>{{end}}

    {{/* The newest poll, with its vote form and results. */}}
    {{if .IsHome}}{{pollBox "polls" ""}}{{end}}
</main>
