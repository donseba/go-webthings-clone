{{/* @dot github.com/donseba/go-webthings/modules/events.Event */}}
<main id="content">
    <article>
        <h1>{{.Title}}</h1>
        <p>
            <time datetime="{{.Start.Format "2006-01-02T15:04:05Z07:00"}}">{{template "partials/when.gohtml" .When}}</time>
            {{if not .AllDay}}({{.Timezone}}){{end}}
        </p>
        {{with .Location}}<p>{{.}}{{with $.Address}}<br>{{.}}{{end}}</p>{{end}}
        {{if .ImageURL}}<img src="{{.ImageURL}}"{{with .ImageSrcset}} srcset="{{.}}" sizes="100vw"{{end}} alt="">{{end}}
        {{with .Summary}}<p>{{.}}</p>{{end}}
        <div>{{.Body}}</div>
    </article>

    {{/* Places, prices and the sign-up form, once editors open sign-ups for this event. */}}
    {{registrationForm "signup" .ID}}
</main>
