{{/* @dot github.com/donseba/go-webthings/modules/events.ListView */}}
<main id="content">
    <h1>{{.Title}}</h1>

    <nav>
        {{if .Past}}<a href="{{.UpcomingURL}}">Upcoming</a>{{else}}<a href="{{.PastURL}}">Past events</a>{{end}}
    </nav>

    {{range .Events}}
        <article>
            {{with .ImageURL}}<img src="{{image . "400x300 crop"}}" alt="">{{end}}
            <h2><a href="{{.URL}}">{{.Title}}</a></h2>
            <p>
                <time datetime="{{.Start.Format "2006-01-02T15:04:05Z07:00"}}">{{template "partials/when.gohtml" .When}}</time>
                {{with .Location}} · {{.}}{{end}}
            </p>
            {{with .Summary}}<p>{{.}}</p>{{end}}
        </article>
    {{else}}
        <p>No events.</p>
    {{end}}
</main>
