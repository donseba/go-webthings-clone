{{/* @dot github.com/donseba/go-webthings/modules/publishing.Post */}}
{{/* Starting point generated by WebThings: every field of the data is used below. */}}
<main id="content">
    {{/* ID: {{.ID}} — stable, usable as an anchor */}}
    <h1>{{.Title}}</h1>
    {{with .Excerpt}}<p>{{.}}</p>{{end}}
    <div>{{.Body}}</div>
    {{if not .Date.IsZero}}<time datetime="{{.Date.Format "2006-01-02T15:04:05Z07:00"}}">{{date .Date "long"}}</time>{{end}}
    {{with .URL}}<a href="{{.}}">URL</a>{{end}}
    {{if .ImageURL}}<img src="{{.ImageURL}}"{{with .ImageSrcset}} srcset="{{.}}" sizes="100vw"{{end}} alt="">{{end}}
    {{range .Categories}}
        <article>
            {{/* ID: {{.ID}} — stable, usable as an anchor */}}
            <h3>{{.Title}}</h3>
            {{with .URL}}<a href="{{.}}">URL</a>{{end}}
            {{if .Active}}<p>Active</p>{{end}}
        </article>
    {{end}}

    {{shareBar "" .Title}}

    {{/* The approved comments on this post and the comment form. */}}
    {{commentThread "comments" .ID}}
</main>
